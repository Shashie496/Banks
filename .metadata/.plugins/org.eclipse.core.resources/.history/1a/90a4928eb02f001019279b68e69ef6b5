	@Override
	public Bank uupdateBank(long id, Bank bank) {
	    Optional<Bank> optionalBank = bankRepo.findById(id);
	    if (optionalBank.isPresent()) {
	        Bank existingBank = optionalBank.get();

	        existingBank.setName(bank.getName());
	        existingBank.setEmail(bank.getEmail());
	        existingBank.setMobile(bank.getMobile());
	        existingBank.setBankName(bank.getBankName());

	        Account account = bank.getAccount();
	        if (account != null) {
	            account.setBank(existingBank); // maintain the bi-directional relationship
	            existingBank.setAccount(account);
	        }

	        return bankRepo.save(existingBank);
	    } else {
	        throw new ResourseNotFoundException("cannot update for this id" +id);
	    }
	}

	@Override
	public Page<Bank> page(int page, int size) {
		
		PageRequest pageeee = PageRequest.of(page, size);
	
		return bankRepo.findAll(pageeee);
	}

	@Override
	public Bank deleteCustomer(long id) {
		
		if(bankRepo.existsById(id)) {
		return bankRepo.deleteById(id);
		}else {
			throw new ResourseNotFoundException("cannot delete for this id" +id);
		}
		
		
	}


